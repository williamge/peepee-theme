{
  "name": "peepee-theme",
  "displayName": "peepee-theme",
  "description": "",
  "version": "0.7.0",
  "repository": "williamge/peepee-theme",
  "publisher": "PeeEnterprises",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.json\" \"**/*.md\" --ignore-path .gitignore",
    "lint": "markdownlint \"**/*.md\" --ignore node_modules --ignore-path .markdownlintignore",
    "check": "prettier --check \"**/*.json\" \"**/*.md\" --ignore-path .gitignore && markdownlint \"**/*.md\" --ignore node_modules --ignore-path .markdownlintignore"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.5.3"
  },
  "contributes": {
    "themes": [
      {
        "label": "peepee-theme",
        "uiTheme": "vs-dark",
        "path": "./themes/peepee-theme-color-theme.json"
      }
    ]
  }
}
