{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "peepee-theme",
  "author": "PeeEnterprises",
  "themes": [
    {
      "name": "peepee-theme",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "accents": [],
        "background": "#181818",
        "drop_target.background": "#383b3d",
        "toolbar.background": "#181818",
        "search.match_background": "#00cc44a8",
        "scrollbar.track.background": "#181818",
        "editor.foreground": "#b9b9b9",
        "editor.background": "#181818",
        "editor.gutter.background": "#181818",
        "editor.active_line.background": "#222222",
        "editor.line_number": "#404040",
        "editor.active_line_number": "#888888",
        "editor.document_highlight.bracket_background": "#249024",
        "hint": "#969696ff",
        "players": [],
        "syntax": {
          "attribute": {
            "color": "#eb6eb7"
          },
          "boolean": {
            "color": "#e67f43",
            "font_style": "italic"
          },
          "comment": {
            "color": "#51616D"
          },
          "comment.doc": {
            "color": "#51616D"
          },
          "constant": {
            "color": "#e67f43",
            "font_style": "italic"
          },
          "constructor": {
            "color": "#56d8c9",
            "font_style": "italic"
          },
          "emphasis": {
            "font_style": "italic"
          },
          "emphasis.strong": {
            "font_weight": 700
          },
          "function": {
            "color": "#56d8c9"
          },
          "function.definition": {
            "color": "#56d8c9",
            "font_weight": 700
          },
          "keyword": {
            "color": "#777777"
          },
          "number": {
            "color": "#dbb32d"
          },
          "operator": {
            "color": "#777777"
          },
          "property": {
            "color": "#A98F80",
            "font_style": "italic"
          },
          "punctuation": {
            "color": "#dedede"
          },
          "punctuation.bracket": {
            "color": "#dedede"
          },
          "punctuation.delimiter": {
            "color": "#dedede"
          },
          "string": {
            "color": "#70b433"
          },
          "string.escape": {
            "color": "#83c746"
          },
          "string.special.symbol": {
            "color": "#A98F80",
            "font_style": "italic"
          },
          "tag": {
            "color": "#56d8c9",
            "font_style": "italic"
          },
          "title": {
            "color": "#4f9cfe",
            "font_weight": 700
          },
          "type": {
            "color": "#56d8c9",
            "font_weight": 700
          },
          "variable": {
            "color": "#dedede"
          },
          "variable.special": {
            "color": "#368aeb",
            "font_style": "italic"
          }
        }
      }
    }
  ]
}
